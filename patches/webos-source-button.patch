+void BraveActionsContainer::AddActionViewForSource() {
+  if (!browser_window_interface_) {
+    return;
+  }
+  auto button = std::make_unique<ToolbarButton>(
+      base::BindRepeating(&BraveActionsContainer::OpenProjectSource,
+                          weak_ptr_factory_.GetWeakPtr()));
+  button->SetVectorIcon(kLeoSocialGithubIcon);
+  button->SetTooltipText(u"GitHub: WebOS-Brave-Browser-Port");
+  button->SetAccessibleName(u"GitHub: WebOS-Brave-Browser-Port");
+  button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  button->SetFlipCanvasOnPaintForRTLUI(false);
+  button->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+  button->SetPreferredSize(GetActionSize());
+  source_action_btn_ =
+      AddChildViewAt(std::move(button), shields_action_btn_ ? 1 : 0);
+}
+
+void BraveActionsContainer::OpenProjectSource() {
+  NavigateParams params(
+      browser_window_interface_,
+      GURL("https://github.com/pecrow/WebOS-Brave-Browser-Port"),
+      ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.user_gesture = true;
+  Navigate(&params);
+}
