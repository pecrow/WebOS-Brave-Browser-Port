+TEST_F(AACTest, HlsExplicitSbrCreatesLcAdts) {
+  const struct {
+    std::vector<uint8_t> config;
+    int core_rate;
+    std::vector<uint8_t> core_config;
+  } cases[] = {
+      {{0x29, 0x91, 0x88, 0x00}, 48000, {0x11, 0x90}},
+      {{0x2b, 0x11, 0x88, 0x00}, 24000, {0x13, 0x10}},
+  };
+  for (const auto& test : cases) {
+    ASSERT_TRUE(Parse(test.config));
+    EXPECT_TRUE(aac_.fits_in_adts());
+    EXPECT_EQ(aac_.GetOutputSamplesPerSecond(false), 48000);
+    EXPECT_EQ(aac_.GetChannelLayout(false), ChannelLayoutConfig::Stereo());
+
+    const uint8_t packet[] = {0x00, 0x01, 0x02};
+    size_t header_size = 0;
+    const auto adts = aac_.CreateAdtsFromEsds(packet, &header_size);
+    ASSERT_EQ(header_size, kADTSHeaderMinSize);
+    ASSERT_EQ(adts.size(), sizeof(packet) + header_size);
+    EXPECT_EQ(adts.subspan(header_size), base::span(packet));
+
+    const auto header = ADTSStreamParser::ParseHeader(adts);
+    ASSERT_TRUE(header);
+    EXPECT_EQ(header->sample_rate, test.core_rate);
+    EXPECT_EQ(header->channel_layout, ChannelLayout::CHANNEL_LAYOUT_STEREO);
+    EXPECT_EQ(base::span(header->extra_data), base::span(test.core_config));
+  }
+}
